AWS_DEFAULT_REGION=us-east-1
GATEWAY_API_KEY=replace-with-a-long-random-value
LISTEN_ADDR=:8080
MODEL_CONFIG_FILE=configs/models.json
MAX_BODY_BYTES=20971520
SHUTDOWN_TIMEOUT=15s

# 火山方舟 Ark（仅当 models.json 登记了 provider=ark 的模型时必填）
ARK_API_KEY=
# 末尾不要带斜杠（带了也会被自动去掉）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 非流式请求的总时长上限；流式只用它约束「等到响应头」的时间，不限制读流的总时长
ARK_TIMEOUT=120s
